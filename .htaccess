# يُقرأ هذا الملف من خوادم Apache مثل XAMPP فقط.
# صفحات GitHub لا تستخدمه، فوجوده لا يؤثّر على الموقع المنشور.

# منع الوصول عبر الويب إلى ملفات التطوير ومجلّد git
RedirectMatch 404 /\.git(/|$)
RedirectMatch 404 /\.github(/|$)
RedirectMatch 404 /\.githooks(/|$)
RedirectMatch 404 /\.gitignore$
RedirectMatch 404 /tests(/|$)
RedirectMatch 404 /scripts(/|$)
RedirectMatch 404 /package(-lock)?\.json$

# نوع المحتوى الصحيح لأوزان النموذج
AddType application/octet-stream .bin

# عدم تخزين الصفحات مؤقتاً أثناء التطوير
<FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
